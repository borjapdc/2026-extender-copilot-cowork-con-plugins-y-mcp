@host = http://localhost:3001

# NOTE: MCP Streamable HTTP transport uses POST /mcp as the MCP endpoint.
# Responses are returned as SSE (text/event-stream) — use the Accept header below.

### Health check
GET {{host}}/health

### Tools list (debug endpoint)
GET {{host}}/tools

### Initialize MCP session
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2024-11-05",
    "capabilities": {},
    "clientInfo": {
      "name": "test-client",
      "version": "1.0.0"
    }
  }
}

### List MCP tools
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

### Call recommend_knight tool
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "recommend_knight",
    "arguments": {
      "enemyType": "ice",
      "location": "Acuario",
      "urgency": "high",
      "availableKnights": "Seiya,Shiryu,Hyoga,Shun,Ikki"
    }
  }
}

### Call classify_threat tool
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "classify_threat",
    "arguments": {
      "description": "High cosmic energy detected near the house of Leo. Possible divine-level threat.",
      "location": "Leo",
      "damageType": "cosmic"
    }
  }
}

### Call simulate_battle tool
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 5,
  "method": "tools/call",
  "params": {
    "name": "simulate_battle",
    "arguments": {
      "fighterA": "Seiya",
      "fighterB": "Ikki",
      "scenario": "Sanctuary"
    }
  }
}

### Call evaluate_cosmos tool
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 6,
  "method": "tools/call",
  "params": {
    "name": "evaluate_cosmos",
    "arguments": {
      "knightName": "Shiryu",
      "context": "after a long battle against a Gold Knight"
    }
  }
}

### Call generate_mission tool
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 7,
  "method": "tools/call",
  "params": {
    "name": "generate_mission",
    "arguments": {
      "objective": "Protect the passage to Athena's chamber",
      "location": "Sagitario",
      "assignedKnights": "Seiya,Shiryu,Shun",
      "threatLevel": "gold"
    }
  }
}

